)

.create-merge table GrowthProposals (
    ProposalId: string,
    Kind: string,
    Payload: dynamic,
    RiskLevel: string,
    Status: string,
    EvidenceRefs: dynamic,
    CreatedAt: datetime,
    ReviewedAt: datetime,
    ReviewedBy: string
)

// ── Table: Conversations ──────────────────────────────────────────
// Chat history logged by the cognition layer after each exchange.
.create-merge table Conversations (
    SessionId: string,
    Timestamp: datetime,
    Role: string,
    Provider: string,
    Model: string,
    Content: string,
    TokenEstimate: int,
    ImageGenerated: bool,
    TurnId: string
)

.ingest inline into table Conversations <|
