)

.create-or-alter table Skills ingestion csv mapping "SkillsDefaultSeedMapping" '[{"column":"SkillId","Properties":{"Ordinal":"0"}},{"column":"Name","Properties":{"Ordinal":"1"}},{"column":"Description","Properties":{"Ordinal":"2"}},{"column":"Category","Properties":{"Ordinal":"3"}},{"column":"Instructions","Properties":{"Ordinal":"4"}},{"column":"Tools","Properties":{"Ordinal":"5"}},{"column":"Tags","Properties":{"Ordinal":"6"}},{"column":"Config","Properties":{"Ordinal":"7"}},{"column":"Source","Properties":{"Ordinal":"8"}},{"column":"Status","Properties":{"Ordinal":"9"}},{"column":"CreatedAt","Properties":{"Ordinal":"10"}},{"column":"UpdatedAt","Properties":{"Ordinal":"11"}}]'

.ingest inline into table Skills with (format='csv', ingestionMappingReference='SkillsDefaultSeedMapping') <|
skill-morning-briefing,Morning Briefing,"Deliver a personalized morning briefing with weather, news, and schedule.",Information & Research,"1. Check [User Profile] for user_location. If found, use it.\n2. If no location is stored, state that Eva has not learned it yet and ask the user to share their city or region for future briefings.\n3. Use [Data Retrieved] for weather forecast and current conditions at that location.\n4. Use [Data Retrieved] for top news headlines.\n5. Combine into a concise briefing: weather summary, personal day context, top 3-5 headlines, and a compact market section.\n6. Do NOT take screenshots or infer a location from unstructured conversation.\n7. Present naturally in first person as Eva.","web-search,weather-news,data-retrieval","Give me my morning briefing,What should I know today?,Catch me up on the morning","{""allowed_fallbacks"":[""Use the location named in the request"",""State which briefing data is unavailable instead of inventing it""],""defaults"":{""headline_count"":5,""include_schedule"":true}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-web-lookup,Web Information Lookup,"Search the web for current information, facts, or answers.",Information & Research,"1. The data pipeline retrieves web results automatically. Check [Data Retrieved] first.\n2. If [Data Retrieved] has relevant results, synthesize them into a natural answer.\n3. If no data was retrieved, say so honestly. Do NOT fabricate results.\n4. Always cite sources when available.\n5. Do NOT say you cannot search the web. The pipeline handles it.","web-search,data-retrieval","Look this up,Find current information about this,Research this topic","{""allowed_fallbacks"":[""Use supplied source material when it is authoritative"",""Ask for a narrower query when the request is ambiguous""],""defaults"":{""cite_sources"":true,""source_count"":5}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-weather,Weather Report,Provide current weather and forecast for a location.,Information & Research,"1. Determine location: check [User Profile] for user_location, or use the location specified in the request.\n2. Weather data is in [Data Retrieved]. Use it as the authoritative source.\n3. Present current conditions, temperature, and a forecast summary.\n4. Do NOT take screenshots. Do NOT fabricate weather data.","weather-news,data-retrieval","What's the weather?,Will it rain today?,Give me the forecast for this weekend","{""allowed_fallbacks"":[""Use web search for the resolved location when a dedicated weather tool is unavailable"",""Ask for a location when none is available"",""Report only the fields returned by the weather source""],""defaults"":{""default_location"":"""",""forecast_days"":3,""temperature_unit"":""source default""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-news,News Headlines,Provide current news headlines and summaries.,Information & Research,"1. News data is in [Data Retrieved]. Use it as the authoritative source.\n2. Present top headlines with brief summaries.\n3. Do NOT fabricate headlines, sources, or events.\n4. Cite the source only if it appears in the data.","web-search,data-retrieval","What are today's headlines?,Catch me up on the news,Summarize the latest news","{""allowed_fallbacks"":[""Summarize user-provided articles"",""Say when no current news data is available""],""defaults"":{""headline_count"":5,""summary_length"":""brief""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-location-deduction,Location Deduction,Determine the user's approximate location from available data.,Information & Research,"1. Check [User Profile] for stored user_location. If found, use it directly.\n2. If not stored, use web search to perform IP-based geolocation lookup.\n3. Once determined, state the approximate location and use it for follow-up tasks.\n4. Do NOT take desktop screenshots to determine location.\n5. Do NOT repeatedly ask for a location if an approved lookup can provide it.","web-search,data-retrieval","Where am I?,Use my location for the weather,What city am I in?","{""allowed_fallbacks"":[""Use a location explicitly supplied by the user"",""Ask the user when only a precise address would work""],""defaults"":{""precision"":""city"",""use_ip_lookup"":true}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-desktop-control,Desktop Application Control,Launch and operate desktop applications by sight.,Browser & Desktop Automation,"1. Emit [[EVA_DESKTOP]]{""goal"":""<plain-language task>""}[[/EVA_DESKTOP]] marker.\n2. The vision agent opens apps, clicks, and types via the real mouse and keyboard.\n3. Write one short sentence about what you are about to do, then emit the marker.\n4. Do NOT list manual steps. Do NOT claim the task is complete before the agent reports success.",desktop-control,"Open my editor,Launch the file manager,Click through this desktop task","{""allowed_fallbacks"":[""Explain the steps without taking action when desktop control is unavailable"",""Ask for confirmation before consequential actions""],""defaults"":{""confirm_irreversible_actions"":true}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-browser-agent,Browser Task Automation,Control a real web browser to complete tasks.,Browser & Desktop Automation,"1. Emit [[EVA_BROWSER]]{""goal"":""<task>"",""start_url"":""<url>""}[[/EVA_BROWSER]] marker.\n2. The browser agent navigates, clicks, types, and reads pages.\n3. Use the persistent browser profile only as authorized by the user.\n4. Pause at purchase or irreversible actions for user confirmation.\n5. Write one short sentence about what you are about to do, then emit the marker.\n6. Do NOT claim a website action succeeded until the agent reports success.",browser-control,"Open this website,Fill out this web form,Find this on the web for me","{""allowed_fallbacks"":[""Search and summarize without submitting changes"",""Ask the user to complete an unavailable authenticated step""],""defaults"":{""confirm_irreversible"":true,""confirm_purchase"":true}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-camera-vision,Camera / Webcam Vision,See through the user's webcam to describe the physical world.,Vision & Media,"1. Emit [[EVA_LOOK]]{""question"":""<what to look for>""}[[/EVA_LOOK]] marker.\n2. A frame is captured from the webcam and you describe what you see.\n3. Use for physical-world questions such as what the user is holding or showing.\n4. Do NOT confuse camera input with screenshots of the monitor.",camera-vision,"What am I holding?,Look at this,What do you see through the camera?","{""allowed_fallbacks"":[""Ask the user to upload an image"",""Explain that no camera frame was available""],""defaults"":{""capture_count"":1,""describe_uncertainty"":true}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-file-creation,"File Creation (PDF, CSV, etc.)","Create downloadable files such as PDFs, CSVs, or reports.",Documents & Data,"1. When asked to create a file, the system writes it to EVA_ARTIFACTS_DIR.\n2. After the file is written, end your message with: [[EVA_FILE]] <filename.ext>.\n3. The frontend converts this marker into a working download link.\n4. Do NOT produce blob: URLs or markdown download links with blob: hrefs.\n5. Do NOT claim a file was produced unless it was actually written.","data-retrieval,file.download","Create a CSV,Make a PDF report,Export this as a file","{""allowed_fallbacks"":[""Provide formatted content for the user to save"",""Explain the file creation failure without claiming success""],""defaults"":{""csv_delimiter"":"","",""pdf_page_size"":""source default""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-open-file,Open File on Desktop,Open a file using the system's default application.,Browser & Desktop Automation,"1. When asked to open a file, use [[EVA_DESKTOP]] with a goal like 'open the file <path> with the default application'.\n2. Do NOT re-create the file. Do NOT just provide a download link.\n3. The desktop agent uses the system file handler to open it.\n4. If the file was just created as an artifact, use ~/.config/eva-standalone/artifacts/<filename>.",desktop-control,"Open this PDF,Show me the file,Open the report on my desktop","{""allowed_fallbacks"":[""Provide the path when desktop control is unavailable"",""Ask the user to confirm an ambiguous file path""],""defaults"":{""use_default_application"":true}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-docx,DOCX Documents,"Create, read, validate, edit, and render DOCX files to bounded PDF outputs.",Documents & Data,"Use Eva's bounded docx skill for real DOCX create, read, validate, edit, and render operations. Supply relative input and output paths under Eva's artifacts directory or an explicitly approved workspace root. Use options.text for creation, options.replace for a bounded text replacement, options.append_text for an appended paragraph, and options.metadata for core properties. Render accepts only a .pdf output and uses a fixed LibreOffice conversion in an isolated temporary profile. Wait for the action receipt and report failure details exactly; do not claim a document was written until validation is valid.","skills.docx,python-docx,LibreOffice","Create a DOCX from these notes,Replace a phrase in report.docx,Render this Word document to PDF","{""allowed_fallbacks"":[""Return the structured missing-dependency error"",""Provide plain text for the user to save when DOCX tooling is unavailable""],""defaults"":{""max_input_bytes"":26214400,""operation"":""create"",""render_format"":""pdf"",""root"":""artifacts""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-pdf,PDF Documents,"Create, inspect, fill, validate, merge, split, extract, table-scan, and OCR bounded PDF files.",Documents & Data,"Use Eva's bounded pdf skill for real PDF creation, reading, validation, merge, split, text extraction, inspect-form, fill-form, tables, and OCR operations. Supply relative paths under Eva's artifacts directory or an explicitly approved workspace root. Use options.text for creation, options.page for one-page split, options.fields for named form values, and a .txt output for extraction or optional OCR text. fill-form rejects unknown field names unless options.allow_unknown is explicitly true and always writes a new PDF. tables uses pdfplumber with fixed page, row, cell, and result bounds. OCR renders only through the fixed pdftoppm executable and pytesseract with fixed page and time bounds; it never accepts an executable, command, or arbitrary arguments. Wait for the action receipt and report warnings or validation failures; do not substitute a text file with a PDF extension.","skills.pdf,pypdf,reportlab,pdfplumber,pytesseract,Poppler","Inspect the fields in this PDF form,Fill customer_name in invoice.pdf,Extract the tables or OCR this PDF","{""allowed_fallbacks"":[""Return the structured missing-dependency error"",""Provide extracted text inline when a PDF output is not possible""],""defaults"":{""ocr_max_pages"":10,""operation"":""validate"",""page_size"":""letter"",""root"":""artifacts""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-pptx,PPTX Presentations,"Create, inspect, validate, edit, and render PPTX presentations to bounded PDF outputs.",Documents & Data,"Use Eva's bounded pptx skill for real PPTX create, read, validate, basic shape-text edit, and render operations. Supply relative paths under Eva's artifacts directory or an explicitly approved workspace root. Use options.title and options.body for creation or options.replace for text replacement. Render accepts only a .pdf output and uses a fixed LibreOffice conversion in an isolated temporary profile. Wait for the validation receipt before describing the presentation as complete.","skills.pptx,python-pptx,LibreOffice","Create a one-slide PPTX,Replace the title in deck.pptx,Render this presentation to PDF","{""allowed_fallbacks"":[""Return the structured missing-dependency error"",""Provide slide text as a plain response when presentation tooling is unavailable""],""defaults"":{""layout"":""title and content"",""operation"":""create"",""render_format"":""pdf"",""root"":""artifacts""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
skill-xlsx,XLSX Spreadsheets,"Create, inspect, validate, edit, and recalculate XLSX workbooks without mutating the input.",Documents & Data,"Use Eva's bounded xlsx skill for real workbook create, read, validate, edit, and formula-recalculation operations. Supply relative input and output paths under Eva's artifacts directory or an explicitly approved workspace root. Use options.rows for creation, options.cells for bounded cell edits, options.sheet for a sheet name, and an explicit .xlsx output for recalculate. Recalculation invokes only fixed LibreOffice/soffice in an isolated temporary profile and never mutates the input. The output is reopened with openpyxl and receives a bounded cached-result and formula-error scan; missing cached values are reported as warnings and cached formula errors fail validation. Keep validate separate when no calculation is requested.","skills.xlsx,openpyxl,LibreOffice","Create an XLSX from these rows,Set cell B2 in workbook.xlsx,Recalculate this spreadsheet","{""allowed_fallbacks"":[""Return the structured missing-dependency error"",""Report workbook values inline without changing the source when editing is unavailable""],""defaults"":{""formula_policy"":""recalculate-to-explicit-output"",""operation"":""validate"",""root"":""artifacts""}}",seed,active,2026-01-01T00:00:00Z,2026-01-01T00:00:00Z
