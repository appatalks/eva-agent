{
  "name": "eva-standalone",
  "version": "5.6.8",
  "author": "@apptalks",
  "desktopName": "Eva",
  "description": "Localhost Electron shell for Eva AI Assistant.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:workspace": "electron . --eva-workspace-terminal-v1",
    "dist": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win nsis",
    "dist:all": "electron-builder --linux AppImage --mac --win nsis"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "tmp": "^0.2.7"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6"
  },
  "_comment": "Electron files stay in standalone/. electron-builder copies the parent web UI and bridge with extraResources into resources/app.",
  "build": {
    "appId": "com.appatalks.eva-standalone",
    "productName": "Eva Standalone",
    "icon": "../core/img/eva-icon.svg",
    "npmRebuild": false,
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "context-menu.js",
      "runtime-logger.js",
      "workspace-projection.js",
      "terminal-broker.js"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "index.html",
          "README.md",
          "README-2.md",
          "config.example.json",
          "config.local.example.js",
          "mcp.json",
          "docs/eva_default_skills/**",
          "core/**",
          "!core/audio/**",
          "core/audio/eva_voice_profile-english.wav",
          "core/audio/eva_voice_profile-korean.wav",
          "core/audio/appatalks_voice_profile-english.wav",
          "tools/acp_bridge.py",
          "tools/generate_skill_seed.py",
          "tools/skills/**",
          "tools/local_voices_bridge.py",
          "tools/voice_clone_module/**",
          "!tools/voice_clone_module/build/**",
          "!tools/voice_clone_module/**/*.egg-info/**",
          "!tools/voice_clone_module/**/__pycache__/**",
          "!tools/voice_clone_module/**/*.pyc",
          "tools/bridge/**",
          "tools/browser_agent.py",
          "tools/desktop_agent.py",
          "tools/camera_sense.py",
          "tools/kusto_mcp.py",
          "tools/web_search_mcp.py",
          "tools/sqlite_memory.py",
          "tools/sqlite_mcp.py",
          "tools/protected_memory.py",
          "tools/eva_seed.kql",
          "!config.json",
          "!config.local.js",
          "!core/external/*.data",
          "!audio/**",
          "!tmp/**",
          "!*.log",
          "!**/*.log",
          "!**/.env*",
          "!standalone/**"
        ]
      },
      {
        "from": "runtime/install-windows-prereqs.ps1",
        "to": "runtime/install-windows-prereqs.ps1"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
