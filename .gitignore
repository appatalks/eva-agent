node_modules/
standalone/node_modules/
standalone/dist/
standalone/dist-*/
standalone/out/
*.AppImage
core/img/eva-memory-graph.png

# Local-only agent knowledge for the maintainer (never committed).
# Holds dev topology, cluster URLs, recurring commands, and agent playbooks
# that reference internal hosts. Keep all secrets and internal URLs here.
.github/agents/local/

# Eva-generated data artifacts. The file.download capability namespaces
# downloads under tmp/<session_id>/ so each session's artifacts are isolated
# and easy to clean up. Never commit the contents.
tmp/
tools/eval/results/

# Core-maintainer local validation. New phase tests and their fixtures remain
# local-only; generated results belong under this directory as well.
tools/tests/local/
tools/tests/.pytest_cache/
tools/tests/__pycache__/

# Ad hoc regression scripts remain local validation unless deliberately
# promoted into the committed CI contract.
tools/local-tests/
tools/tests/local/test_readiness_verdict.py
tools/tests/local/test_kusto_turn_stages.py
